{
  "manifest_version": 3,
  "name": "Fog",
  "version": "1.0",
  "description": "Dim or brighten any web page and control its audio volume — one panel per tab.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["fog.js"], "run_at": "document_idle" }
  ],
  "action": {
    "default_title": "Fog",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
